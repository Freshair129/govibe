{
  "name": "govibe-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "govibe": "./packages/govibe-core/bin/init.mjs"
  },
  "description": "GoVibe Mission Control - React dashboard with real data entrypoints",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "npm run test:security && vitest run",
    "test:security": "node --test scripts/mcp/mission-protocol.test.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:landing": "playwright test e2e/landing-page.spec.ts",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "diff:check": "node scripts/docs/diff-check.mjs",
    "diff:check:staged": "node scripts/docs/diff-check.mjs --staged",
    "msp:evidence": "node scripts/docs/msp-evidence.mjs",
    "gemini:doc-audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agents/run-gemini-doc-audit.ps1",
    "baseline:check": "npm run docs:validate && npm run roadmap:validate && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "mcp:smoke": "node scripts/mcp/smoke-test.mjs",
    "roadmap:validate": "node scripts/docs/validate-roadmap-containers.mjs",
    "roadmap:export": "node scripts/mcp/export-roadmap.mjs",
    "mcp:dev": "node scripts/mcp/govibe-mcp-server.mjs",
    "mission:dev": "node scripts/mcp/govibe-mcp-server.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "node-html-parser": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}

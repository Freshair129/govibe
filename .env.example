# Mission Control sidecar authentication
GOVIBE_MCP_TOKEN=replace-with-a-random-local-token
VITE_GOVIBE_MCP_TOKEN=replace-with-the-same-random-local-token
# Optional comma-separated exact origins. Wildcards are ignored; default is the current app origin.
VITE_GOVIBE_EVENT_ORIGINS=http://localhost:1420
# Unsafe development-only compatibility interface. Keep disabled outside isolated local development.
VITE_GOVIBE_ALLOW_CUSTOM_EVENTS=false
# Optional JSON arrays of absolute server-side roots. Defaults to docs/roadmap for both.
# GOVIBE_ROADMAP_READ_ROOTS=["G:\\govibe\\docs\\roadmap"]
# GOVIBE_ROADMAP_WRITE_ROOTS=["G:\\govibe\\docs\\roadmap"]

# Comma-separated browser origins allowed to call the local sidecar.
GOVIBE_MCP_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173

# Optional sidecar limits and address overrides.
GOVIBE_MCP_MAX_BODY_BYTES=1000000
GOVIBE_MCP_HOST=127.0.0.1
GOVIBE_MCP_PORT=4310

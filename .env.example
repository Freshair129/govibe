# Mission Control sidecar authentication
GOVIBE_MCP_TOKEN=replace-with-a-random-local-token
VITE_GOVIBE_MCP_TOKEN=replace-with-the-same-random-local-token

# Comma-separated browser origins allowed to call the local sidecar.
GOVIBE_MCP_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173

# Optional sidecar limits and address overrides.
GOVIBE_MCP_MAX_BODY_BYTES=1000000
GOVIBE_MCP_HOST=127.0.0.1
GOVIBE_MCP_PORT=4310

{
  "concurrency": 3,
  "leaseMs": 1800000,

  "project": {
    "name": "GoVibe",
    "repoRoot": "G:/govibe",
    "stack": ["React", "Vite", "TypeScript", "Node ESM MCP server"],
    "langLine": "TypeScript/React (src/) + Node ESM MCP runtime (scripts/mcp/) + this forked engine (engine/)",
    "exclusions": []
  },

  "providers": {
    "claude": {
      "enabled": true,
      "capabilities": ["file_edit", "shell_exec", "code_review", "streaming", "long_context"],
      "transport": "subprocess",
      "command": "claude",
      "baseArgs": ["-p", "--output-format", "stream-json", "--verbose"],
      "extraArgs": ["--permission-mode", "acceptEdits"],
      "auth": {
        "mode": "plan",
        "apiKey": "",
        "_comment": "mode: 'plan' = à¹ƒà¸Šà¹‰à¹‚à¸„à¸§à¸•à¹‰à¸² subscription, 'apikey' = à¹ƒà¸Šà¹‰ API billing. à¸ªà¸¥à¸±à¸šà¹„à¸”à¹‰à¸ªà¸”à¸œà¹ˆà¸²à¸™ UI."
      },
      "tiers": {
        "opus": "opus",
        "sonnet": "sonnet",
        "haiku": "haiku"
      }
    },
    "ollama": {
      "enabled": true,
      "capabilities": ["text_gen", "file_edit"],
      "transport": "http",
      "host": "http://127.0.0.1:11434",
      "think": false,
      "tools": true,
      "toolsMaxIter": 20,
      "keepAlive": "30m",
      "defaultProfile": "balanced",
      "_perfComment": "num_ctx sized for micro-tasks to keep KV small (12GB GPU is VRAM-contended ~5GB free when Chrome open). Do NOT set OLLAMA_KV_CACHE_TYPE=q8_0 — it tanks prefill to ~7 tok/s on this box.",
      "profiles": {
        "fast": { "temperature": 0.3, "num_predict": 2048, "num_ctx": 8192 },
        "balanced": { "temperature": 0.4, "num_predict": 4096, "num_ctx": 8192 },
        "ui-heavy": { "temperature": 0.5, "num_predict": 8192, "num_ctx": 12288 },
        "tools": { "temperature": 0.3, "num_predict": 8192, "num_ctx": 16384 }
      },
      "defaultToolsProfile": "tools"
    },
    "codex": {
      "enabled": false,
      "capabilities": ["file_edit", "shell_exec", "sandbox"],
      "transport": "subprocess",
      "command": "codex",
      "baseArgs": ["--approval-mode", "auto-edit", "--quiet"],
      "extraArgs": [],
      "auth": { "envKey": "OPENAI_API_KEY", "apiKey": "" },
      "_comment": "OpenAI Codex CLI. à¹€à¸›à¸´à¸” enabled=true à¹€à¸¡à¸·à¹ˆà¸­à¸•à¸´à¸”à¸•à¸±à¹‰à¸‡à¹à¸¥à¹‰à¸§ + à¸•à¸±à¹‰à¸‡ OPENAI_API_KEY."
    },
    "openrouter": {
      "enabled": false,
      "capabilities": ["text_gen", "streaming", "vision", "long_context"],
      "transport": "http",
      "host": "https://openrouter.ai/api/v1",
      "auth": { "envKey": "OPENROUTER_API_KEY", "apiKey": "" },
      "_comment": "OpenRouter unified API. model = provider slug à¹€à¸Šà¹ˆà¸™ 'anthropic/claude-sonnet-4', 'google/gemma-3-27b'. à¹€à¸›à¸´à¸” enabled + à¸•à¸±à¹‰à¸‡ API key."
    },
    "antigravity": {
      "enabled": false,
      "capabilities": ["text_gen", "file_edit"],
      "transport": "subprocess",
      "command": "antigravity",
      "baseArgs": [],
      "extraArgs": [],
      "_comment": "Antigravity IDE agent. à¹€à¸›à¸´à¸” enabled=true à¹€à¸¡à¸·à¹ˆà¸­à¸•à¸´à¸”à¸•à¸±à¹‰à¸‡à¹à¸¥à¹‰à¸§."
    }
  },

  "roles": {
    "architect": {
      "description": "Complex design, planning, spike analysis, architecture decisions",
      "requires": ["long_context"],
      "preferred": ["claude:opus", "openrouter:anthropic/claude-sonnet-4", "ollama:hf.co/unsloth/gemma-4-12b-it-GGUF:UD-Q4_K_XL", "ollama:gemma4:latest"]
    },
    "coder": {
      "description": "Implementation, testing, integration â€” needs file access",
      "requires": ["file_edit"],
      "preferred": ["claude:sonnet", "codex:o4-mini", "antigravity:default", "ollama:qwen3.5:4b"]
    },
    "worker": {
      "description": "Scaffolding, config files, documentation â€” light work",
      "requires": ["text_gen"],
      "preferred": ["claude:haiku", "ollama:qwen3.5:4b", "ollama:gemma4:latest", "openrouter:google/gemma-3-27b"]
    },
    "reviewer": {
      "description": "Independent verification of worker output (Verify Gate)",
      "requires": ["code_review"],
      "preferred": ["claude:opus", "claude:sonnet"]
    },
    "scout": {
      "description": "Research, drafting, analysis â€” text generation focus",
      "requires": ["text_gen"],
      "preferred": ["ollama:qwen3.5:4b", "claude:haiku", "openrouter:google/gemma-3-27b"]
    }
  },

  "routing": {
    "manual": null,
    "spike": "architect",
    "plan": "architect",
    "architecture": "architect",
    "design": "architect",
    "process": "architect",
    "code": "coder",
    "impl": "coder",
    "integration": "coder",
    "test": "coder",
    "scaffold": "worker",
    "config": "worker",
    "docs": "worker",
    "research": "scout",
    "draft": "scout"
  },

  "review": {
    "enabled": true,
    "requireReviewDefault": true,
    "failOn": "critical",
    "autoRework": true,
    "maxReworkRounds": 1,
    "skipForDraft": false,
    "reviewerRole": "reviewer",
    "l0": {
      "enabled": true,
      "commands": [],
      "timeoutMs": 120000,
      "_comment": "L0 deterministic gate (FEAT-TIERED-REVIEW FR-001 / RM-008): shell checks run in the target repo BEFORE any paid LLM review; any non-zero exit routes to rework at $0. Empty = no-op (back-compat); auto-detected per stack when --repo is used."
    },
    "l1": {
      "enabled": false,
      "model": "ollama:qwen3:latest",
      "lowStakesTypes": ["docs", "scaffold", "config"],
      "_comment": "L1 local-SLM escalate-only pre-filter (FEAT-TIERED-REVIEW FR-002): after L0 passes, a free local model pre-reviews low-stakes output -> 'pass' clears it (skip the paid L2 reviewer) or 'escalate' sends it up. L1 can NEVER reject/rework on its own. enabled=false by default (opt-in). High-stakes types (code/test) always go to L2 (FR-003)."
    },
    "_comment": "Verify Gate (ADR-O-001). reviewerRole à¸à¸³à¸«à¸™à¸”à¸§à¹ˆà¸²à¹ƒà¸Šà¹‰ role à¹„à¸«à¸™à¸£à¸µà¸§à¸´à¸§ â€” resolve à¸œà¹ˆà¸²à¸™ roles[reviewerRole].preferred."
  },

  "usageLimits": {
    "sessionUsd": null,
    "weeklyUsd": null
  },

  "docsForContext": [
    { "path": "CLAUDE.md", "tier": "shared" },
    { "path": "AGENTS.md", "tier": "shared" },
    { "path": "docs/PRD-GoVibe-Platform-Overview.md", "tier": "shared" }
  ],

  "scope": {
    "_comment": "POLA: parent à¸›à¸£à¸°à¸à¸²à¸¨ scope à¸•à¹ˆà¸­ task.",
    "default": { "docs": ["CLAUDE.md", "AGENTS.md", "docs/PRD-GoVibe-Platform-Overview.md"], "budgetTokens": 8000 },
    "byPhase": {
      "spike": { "budgetTokens": 12000 },
      "0": { "budgetTokens": 8000 },
      "1": { "budgetTokens": 9000 },
      "2": { "budgetTokens": 10000 },
      "3": { "budgetTokens": 12000 },
      "4": { "budgetTokens": 10000 },
      "5": { "budgetTokens": 9000 },
      "6": { "budgetTokens": 9000 },
      "7": { "budgetTokens": 9000 },
      "8": { "budgetTokens": 8000 }
    }
  },

  "store": {
    "knowledge": "file",
    "genesisdb": {
      "bindingPath": "G:/GenesisBlock_Dev/GenesisBlock/index.js",
      "path": "",
      "vectorDim": 1024,
      "embedModel": "bge-m3:latest",
      "ollamaHost": "http://127.0.0.1:11434"
    }
  }
}







